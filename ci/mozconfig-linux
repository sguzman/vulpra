# Vulpra CI: full native Firefox build, not artifact mode.
mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-vulpra-linux
ac_add_options --with-branding=browser/branding/unofficial

# Separate application.ini name; Gecko extension compatibility ID is unchanged.
ac_add_options --with-app-basename=Vulpra

# Packaged browser builds omit test-only native binaries; test source is retained.
ac_add_options --disable-tests

# Cache Rust and C/C++ outputs across full native CI builds.
ac_add_options --with-ccache=sccache

# Conservative GitHub hosted-runner memory experiment (4 cores, 15 GiB).
# Limit simultaneous native compiles pending measured memory-pressure evidence.
mk_add_options MOZ_PARALLEL_BUILD=2
