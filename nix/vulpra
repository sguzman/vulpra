#!/usr/bin/env bash
# Vulpra's nom-first Nix entrypoint. Never installs a browser or edits profiles.
set -euo pipefail

usage() {
  cat <<'HELP'
Vulpra Nix launcher (Nix Output Monitor)

  ./nix/vulpra shell           Enter the pinned developer Fish shell via nom
  ./nix/vulpra doctor          Run the read-only toolchain preflight via nom
  ./nix/vulpra source          Inspect source checkout completeness
  ./nix/vulpra check           Syntax-check native build scripts
  ./nix/vulpra configure       Run the native mach configure
  ./nix/vulpra status          Read-only local Firefox 160 source/build status (no Nix/download)
  ./nix/vulpra build           Build verified Firefox 160 Vulpra locally in a separate tree
  ./nix/vulpra build --fetch-source  Approve a one-time official Mozilla SOURCE download
  ./nix/vulpra run             Launch the locally built browser with its private profile
  ./nix/vulpra build --jobs 8  Override local native build parallelism
  ./nix/vulpra package         Package and privately smoke the same locally built Firefox 160
  ./nix/vulpra smoke|wayland|accept|webext|input
  ./nix/vulpra mach ARGS       Delegate mach commands inside the devShell
  ./nix/vulpra help            Show this message

The launcher uses an existing nom from PATH, or obtains a pinned nom
with 'nix shell ./nix#nom' when missing (no profile installation required).
The first bootstrap of nom itself still uses Nix's native output.

The launcher uses nom to monitor Nix's dependency/download/build phase.
The native Firefox/Gecko 'mach build' phase prints ordinary compiler logs,
which nom cannot interpret as Nix derivations. Do not interrupt an active build
just to switch launchers; use this for subsequent invocations.
HELP
}

error() { printf 'Vulpra Nix launcher: %s\n' "$*" >&2; exit 2; }

action="${1:-help}"
if (($#)); then shift; fi

case "$action" in
  help|-h|--help) usage; exit 0 ;;
  status)
    (($# == 0)) || error "'status' takes no extra arguments"
    here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
    [[ -f "$here/scripts/vulpra-build-160.sh" ]] ||
      error "missing main-branch Firefox 160 local source builder"
    exec bash "$here/scripts/vulpra-build-160.sh" --status
    ;;
  shell)
    (($# == 0)) || error "'shell' takes no extra arguments"
    command_args=(fish)
    ;;
  doctor|source|check|configure|build|run|package|smoke|wayland|accept|webext|input|mach)
    command_args=(vulpra-dev "$action" "$@")
    ;;
  *) error "unknown action '$action'; use ./nix/vulpra help" ;;
esac

command -v nix >/dev/null 2>&1 ||
  error "Nix/Lix is not on PATH"
# Resolve relative to this script, not the caller's current directory.
repo="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
[[ -f "$repo/nix/flake.nix" && -f "$repo/nix/flake.lock" ]] ||
  error "missing pinned Nix flake: $repo/nix"
cd "$repo"

# nom's develop shim forwards the interactive/native command once and
# monitors the Nix realization separately. No piped process status is lost.
if command -v nom >/dev/null 2>&1; then
  exec nom develop ./nix --no-write-lock-file --command "${command_args[@]}"
fi

printf 'Vulpra: nom is not on PATH; obtaining pinned nom from ./nix#nom without installing it into your user profile.\n' >&2
# The very first nom bootstrap is necessarily displayed by Nix itself.
# Once realized, nom monitors the developer shell's dependencies as normal.
exec nix shell ./nix#nom --no-write-lock-file --command nom develop ./nix --no-write-lock-file --command "${command_args[@]}"
