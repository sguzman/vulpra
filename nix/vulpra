#!/usr/bin/env bash
# Vulpra's nom-first Nix entrypoint. Never installs a browser or edits profiles.
set -euo pipefail

usage() {
  cat <<'HELP'
Vulpra Nix launcher (Nix Output Monitor)

  ./nix/vulpra shell           Enter the pinned developer Fish shell via nom
  ./nix/vulpra doctor          Run the read-only toolchain preflight via nom
  ./nix/vulpra source          Inspect source checkout completeness
  ./nix/vulpra check           Syntax-check native build scripts
  ./nix/vulpra configure       Configure Firefox 160.0.1 directly from main
  ./nix/vulpra status          Read-only main source/build status (no Nix/download)
  ./nix/vulpra build           Compile committed Firefox 160.0.1 source on main
  ./nix/vulpra run             Dogfood local Vulpra with permanent ~/.local/share/vulpra/default profile
  ./nix/vulpra qa              Run local Vulpra with a separate build QA profile
  ./nix/vulpra security-qa status|setup|sync|snapshot|verify|headless
  ./nix/vulpra security-qa build [--jobs 2]  Explicit separate Nix QA native compile
  ./nix/vulpra security-qa headless-build    Offline smoke of compiled QA binary
  ./nix/vulpra build --jobs 8  Override local native build parallelism
  ./nix/vulpra package         Package and privately smoke the native main build
  ./nix/vulpra smoke|wayland|accept|webext|input
  ./nix/vulpra mach ARGS       Delegate mach commands inside the devShell
  ./nix/vulpra help            Show this message

The launcher uses an existing nom from PATH, or obtains a pinned nom
with 'nix shell path:<checkout>/nix#nom' when missing (no profile installation required).
Only nix/ enters the flake store input; Firefox source stays in the checkout.
The first bootstrap of nom itself still uses Nix's native output.

The launcher uses nom to monitor Nix's dependency/download/build phase.
The native Firefox/Gecko 'mach build' phase prints ordinary compiler logs,
which nom cannot interpret as Nix derivations. Do not interrupt an active build
just to switch launchers; use this for subsequent invocations.
HELP
}

error() { printf 'Vulpra Nix launcher: %s\n' "$*" >&2; exit 2; }

action="${1:-help}"
if (($#)); then shift; fi

case "$action" in
  help|-h|--help) usage; exit 0 ;;
  security-qa)
    # Worktree/snapshot controls never evaluate Nix or run the daily browser.
    repo="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
    [[ -f "$repo/scripts/vulpra-security-qa.sh" ]] ||
      error 'security QA setup script is missing'
    exec bash "$repo/scripts/vulpra-security-qa.sh" "$@"
    ;;
  status)
    (($# == 0)) || error "'status' takes no extra arguments"
    here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
    [[ -f "$here/scripts/vulpra-build-160.sh" ]] ||
      error "missing main-branch Firefox 160 local source builder"
    exec bash "$here/scripts/vulpra-build-160.sh" --status
    ;;
  run|qa)
    # Launching an already compiled binary does not need a Nix realization.
    # Do not let a simple GUI run start downloads on a slow connection.
    repo="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
    [[ -f "$repo/scripts/vulpra-build-160.sh" ]] ||
      error "missing local Vulpra browser launcher"
    (($# == 0)) || error "'$action' takes no extra arguments"
    exec bash "$repo/scripts/vulpra-build-160.sh" "--$action"
    ;;
  build|configure)
    repo="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
    [[ -f "$repo/scripts/vulpra-build-160.sh" ]] ||
      error "missing native main source build entrypoint"
    if [[ "$action" == build ]]; then
      # Validate the committed main source before any Nix realization.
      bash "$repo/scripts/vulpra-build-160.sh" --preflight "$@"
      command_args=(vulpra-dev build "$@")
    else
      (($# == 0)) || error "'configure' takes no arguments"
      bash "$repo/scripts/vulpra-build-160.sh" --preflight
      command_args=(vulpra-dev configure)
    fi
    ;;
  package)
    (($# == 0)) || error "'package' takes no extra arguments"
    repo="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
    [[ -f "$repo/scripts/vulpra-package-160.sh" ]] ||
      error "missing local Vulpra 160 package workflow"
    # Refuse Nix realization/downloads when no compiled local binary exists.
    bash "$repo/scripts/vulpra-package-160.sh" --preflight
    command_args=(vulpra-dev package)
    ;;
  shell)
    (($# == 0)) || error "'shell' takes no extra arguments"
    command_args=(fish)
    ;;
  doctor|source|check|smoke|wayland|accept|webext|input|mach)
    command_args=(vulpra-dev "$action" "$@")
    ;;
  *) error "unknown action '$action'; use ./nix/vulpra help" ;;
esac

command -v nix >/dev/null 2>&1 ||
  error "Nix/Lix is not on PATH"
# Resolve relative to this script, not the caller's current directory.
repo="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
[[ -f "$repo/nix/flake.nix" && -f "$repo/nix/flake.lock" ]] ||
  error "missing pinned Nix flake: $repo/nix"
cd "$repo"

# Explicit path: avoids Nix's implicit git+file:// fetch of the entire
# Firefox checkout. Only repo/nix is copied to /nix/store as the flake source.
# The build still runs against the live source checkout in $repo, not the store.
flake_ref="path:$repo/nix"
# nom's develop shim forwards the interactive/native command once and
# monitors the Nix realization separately. No piped process status is lost.
if command -v nom >/dev/null 2>&1; then
  exec nom develop "$flake_ref" --no-write-lock-file --command "${command_args[@]}"
fi

printf 'Vulpra: nom is not on PATH; obtaining pinned nom from the isolated nix/ flake without installing it into your user profile.\n' >&2
# The very first nom bootstrap is necessarily displayed by Nix itself.
# Once realized, nom monitors the developer shell's dependencies as normal.
exec nix shell "$flake_ref#nom" --no-write-lock-file --command nom develop "$flake_ref" --no-write-lock-file --command "${command_args[@]}"
