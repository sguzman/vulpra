# NOTE: Please keep the files listed in here in sync with the ones listed in
# webext-glue/moz.build, as this ensures that the XPI generated at build time
# shares the same structure as the built-in instance. (bug 1955994)

browser.jar:
  builtin-addons/newtab/manifest.json (./manifest.json)
  builtin-addons/newtab/webext-glue/background.js (./webext-glue/background.js)
# The default wildcard is kept byte-for-byte; only an opt-in Linux build
# enumerates the fixed pinned-source library to omit AdsFeed.sys.mjs.
#ifdef VULPRA_NO_NEWTAB_ADSFEED
  builtin-addons/newtab/lib/AboutPreferences.sys.mjs (./lib/AboutPreferences.sys.mjs)
  builtin-addons/newtab/lib/ActivityStream.sys.mjs (./lib/ActivityStream.sys.mjs)
  builtin-addons/newtab/lib/ActivityStreamMessageChannel.sys.mjs (./lib/ActivityStreamMessageChannel.sys.mjs)
  builtin-addons/newtab/lib/ActivityStreamPrefs.sys.mjs (./lib/ActivityStreamPrefs.sys.mjs)
  builtin-addons/newtab/lib/actors/ (./lib/actors/*)
  builtin-addons/newtab/lib/AdsClient.sys.mjs (./lib/AdsClient.sys.mjs)
  builtin-addons/newtab/lib/cache.worker.js (./lib/cache.worker.js)
  builtin-addons/newtab/lib/DefaultSites.sys.mjs (./lib/DefaultSites.sys.mjs)
  builtin-addons/newtab/lib/DiscoveryStreamFeed.sys.mjs (./lib/DiscoveryStreamFeed.sys.mjs)
  builtin-addons/newtab/lib/DownloadsManager.sys.mjs (./lib/DownloadsManager.sys.mjs)
  builtin-addons/newtab/lib/ExternalComponentsFeed.sys.mjs (./lib/ExternalComponentsFeed.sys.mjs)
  builtin-addons/newtab/lib/FaviconFeed.sys.mjs (./lib/FaviconFeed.sys.mjs)
  builtin-addons/newtab/lib/FrecencyBoostProvider/ (./lib/FrecencyBoostProvider/*)
  builtin-addons/newtab/lib/HighlightsFeed.sys.mjs (./lib/HighlightsFeed.sys.mjs)
  builtin-addons/newtab/lib/ImportHelper.sys.mjs (./lib/ImportHelper.sys.mjs)
  builtin-addons/newtab/lib/InferredModel/ (./lib/InferredModel/*)
  builtin-addons/newtab/lib/InferredPersonalizationFeed.sys.mjs (./lib/InferredPersonalizationFeed.sys.mjs)
  builtin-addons/newtab/lib/NewTabActorRegistry.sys.mjs (./lib/NewTabActorRegistry.sys.mjs)
  builtin-addons/newtab/lib/NewTabAttributionFeed.sys.mjs (./lib/NewTabAttributionFeed.sys.mjs)
  builtin-addons/newtab/lib/NewTabAttributionService.sys.mjs (./lib/NewTabAttributionService.sys.mjs)
  builtin-addons/newtab/lib/NewTabContentPing.sys.mjs (./lib/NewTabContentPing.sys.mjs)
  builtin-addons/newtab/lib/NewTabGleanUtils.sys.mjs (./lib/NewTabGleanUtils.sys.mjs)
  builtin-addons/newtab/lib/NewTabInit.sys.mjs (./lib/NewTabInit.sys.mjs)
  builtin-addons/newtab/lib/NewTabMessaging.sys.mjs (./lib/NewTabMessaging.sys.mjs)
  builtin-addons/newtab/lib/PersistentCache.sys.mjs (./lib/PersistentCache.sys.mjs)
  builtin-addons/newtab/lib/PlacesFeed.sys.mjs (./lib/PlacesFeed.sys.mjs)
  builtin-addons/newtab/lib/PrefsFeed.sys.mjs (./lib/PrefsFeed.sys.mjs)
  builtin-addons/newtab/lib/RemoteRenderer.sys.mjs (./lib/RemoteRenderer.sys.mjs)
  builtin-addons/newtab/lib/Screenshots.sys.mjs (./lib/Screenshots.sys.mjs)
  builtin-addons/newtab/lib/SectionsLayoutFeed.sys.mjs (./lib/SectionsLayoutFeed.sys.mjs)
  builtin-addons/newtab/lib/SectionsManager.sys.mjs (./lib/SectionsManager.sys.mjs)
  builtin-addons/newtab/lib/SiteClassifier.sys.mjs (./lib/SiteClassifier.sys.mjs)
  builtin-addons/newtab/lib/SmartShortcutsFeed.sys.mjs (./lib/SmartShortcutsFeed.sys.mjs)
  builtin-addons/newtab/lib/SmartShortcutsRanker/ (./lib/SmartShortcutsRanker/*)
  builtin-addons/newtab/lib/SponsoredTopSitesScoreProvider/ (./lib/SponsoredTopSitesScoreProvider/*)
  builtin-addons/newtab/lib/StartupCacheInit.sys.mjs (./lib/StartupCacheInit.sys.mjs)
  builtin-addons/newtab/lib/Store.sys.mjs (./lib/Store.sys.mjs)
  builtin-addons/newtab/lib/SystemTickFeed.sys.mjs (./lib/SystemTickFeed.sys.mjs)
  builtin-addons/newtab/lib/TelemetryFeed.sys.mjs (./lib/TelemetryFeed.sys.mjs)
  builtin-addons/newtab/lib/TemporaryMerinoClientShim.sys.mjs (./lib/TemporaryMerinoClientShim.sys.mjs)
