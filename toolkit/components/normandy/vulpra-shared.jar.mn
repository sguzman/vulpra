# Vulpra opt-in Normandy-free builds retain the upstream namespace for the
# minimal helpers still imported by Nimbus, ASRouter and shared targeting.
# Do not remove these resources until all their consumers are migrated.
# The recipe runner, studies frontend, actions and startup client are absent.
toolkit.jar:
% resource normandy %res/normandy/
  res/normandy/lib/ClientEnvironment.sys.mjs (./lib/ClientEnvironment.sys.mjs)
  res/normandy/lib/NormandyApi.sys.mjs (./lib/NormandyApi.sys.mjs)
  res/normandy/lib/NormandyUtils.sys.mjs (./lib/NormandyUtils.sys.mjs)
  res/normandy/schemas/LegacyHeartbeat.schema.json (./schemas/LegacyHeartbeat.schema.json)
