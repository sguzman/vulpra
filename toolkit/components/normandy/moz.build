with Files("**"):
    BUG_COMPONENT = ("Firefox", "Normandy Client")

# The experimental Linux variant retains only shared Nimbus/targeting helpers.
# Normal browser builds continue to package the full upstream Normandy client.
if CONFIG["MOZ_NORMANDY"]:
    JAR_MANIFESTS += ["jar.mn"]
else:
    JAR_MANIFESTS += ["vulpra-shared.jar.mn"]

TESTING_JS_MODULES += [
    "test/NormandyTestUtils.sys.mjs",
]

SPHINX_TREES["normandy"] = "docs"

TEST_DIRS += ["test/browser"]

XPCSHELL_TESTS_MANIFESTS += ["test/unit/xpcshell.toml"]
